# ── Server ──────────────────────────────────────────────
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/NeighborNexus
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:3001

# ── Email (optional) ────────────────────────────────────
# Without SMTP_URL, emails are built and logged but never sent. In-app notifications always work.
# SMTP_URL=smtps://user:password@smtp.example.com
MAIL_FROM=NeighborNexus <no-reply@neighbornexus.local>
APP_URL=http://localhost:3001
# Set to off to stop this process sending reminders (run `npm run reminders` from cron instead).
REMINDERS=on
# Members can reschedule until this many hours before the start. Cancelling is always allowed.
RESCHEDULE_NOTICE_HOURS=12
